# Токен бота из @BotFather
BOT_TOKEN=your_bot_token_here

# Канал для публикаций (@channel_name или -100xxxxxxxxxx)
TG_CHANNEL_ID=@your_channel_name

# Сервисный ключ доступа приложения ВК
VK_ACCESS_TOKEN=your_vk_service_token_here

# Числовой ID группы ВК (без минуса)
VK_GROUP_ID=your_vk_id

# Интервал проверки в секундах
CHECK_INTERVAL_SECS=1800
EOF
